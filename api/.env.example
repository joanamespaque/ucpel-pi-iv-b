# Conexão com o PostgreSQL
DATABASE_URL="postgresql://interct:interct@localhost:5432/interct?schema=public"
# Porta HTTP da API
PORT=3000
# Origens autorizadas a consumir a API (separadas por vírgula)
CORS_ORIGINS="http://localhost:8080"
# Chave exigida no cabeçalho X-API-Key em POST, PUT e DELETE (gere um valor aleatório, por exemplo: openssl rand -hex 32)
API_KEY="troque-por-um-valor-aleatorio"
# Ambiente de execução (development, test ou production)
NODE_ENV=development
