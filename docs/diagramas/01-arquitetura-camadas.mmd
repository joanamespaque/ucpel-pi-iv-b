flowchart TB
  subgraph CLI["Camada de apresentação"]
    direction LR
    NAV["Navegador"]
    SW["Swagger UI<br/>(GitHub Pages e /docs)"]
    subgraph PHP["Cliente web · PHP 8.3 (MVC)"]
      direction TB
      FC["public/index.php<br/>Router"]
      PC["Controllers"]
      V["Views<br/>htmlspecialchars"]
      AC["ApiClient<br/>cURL + JSON + X-API-Key"]
      FC --> PC
      PC --> V
      PC --> AC
    end
    NAV -- "HTML e formulários" --> FC
  end
  subgraph API["InterCT API · Node.js 22 + Express 5"]
    direction TB
    MW["Helmet, CORS, limite de requisições,<br/>requireApiKey (escrita)"]
    R["Rotas /api/v1<br/>validate() com Zod"]
    CT["Controllers<br/>HTTP ⇄ serviço"]
    S["Services<br/>regras de negócio"]
    RP["Repositories<br/>Prisma Client"]
    EH["errorHandler<br/>Problem Details (RFC 9457)"]
    MW --> R --> CT --> S --> RP
    R -. erro de validação .-> EH
    S -. HttpError .-> EH
