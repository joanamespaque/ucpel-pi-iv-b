# Endereço da API (sem /api/v1 no final).
API_BASE_URL=http://localhost:3000
# Chave usada nas operações de escrita. Fica só no servidor, nunca no navegador.
API_KEY=troque-esta-chave
# Hash da senha de acesso às telas de cadastro, gerado com:
# php -r "echo password_hash('sua-senha', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=
APP_ENV=development
