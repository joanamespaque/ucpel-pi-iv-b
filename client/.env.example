# Endereço da API (sem /api/v1 no final).
API_BASE_URL=http://localhost:3000
# Chave usada nas operações de escrita. Fica só no servidor, nunca no navegador.
API_KEY=troque-esta-chave
# Senha de acesso às telas de cadastro. Use uma das opções:
# ADMIN_PASSWORD_HASH, gerado com php -r "echo password_hash('sua-senha', PASSWORD_DEFAULT), PHP_EOL;"
# ou ADMIN_PASSWORD, com um valor aleatório. Sem nenhuma delas, os cadastros ficam desativados.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
APP_ENV=development
